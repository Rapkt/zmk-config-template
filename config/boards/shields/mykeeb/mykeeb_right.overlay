/ {
    chosen {
        zmk,kscan = &kscan0;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        
        // Reversed column order
        col-gpios
            = <&gpio0 9  GPIO_ACTIVE_HIGH> // Col 5 (Now Col 1)
            , <&gpio0 10 GPIO_ACTIVE_HIGH> // Col 4 (Now Col 2)
            , <&gpio1 11 GPIO_ACTIVE_HIGH> // Col 3 (Stays Col 3)
            , <&gpio1 13 GPIO_ACTIVE_HIGH> // Col 2 (Now Col 4)
            , <&gpio1 6  GPIO_ACTIVE_HIGH> // Col 1 (Now Col 5)
            , <&gpio0 24 GPIO_ACTIVE_HIGH> // Col 6 (Dummy pin for pinky edge)
            ;

        // Swapped mid and thumb rows
        row-gpios
            = <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row top
            , <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row mid (Was P0.29)
            , <&gpio0 2  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row bot
            , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row thumb (Was P1.15)
            ;
    };
};
